{
  "compilerOptions": {
    "target": "ES6",
    "module": "commonjs",
    "allowJs": true,
    "checkJs": false,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "typeRoots": ["./src"]
  },
  "include": [
    "examples/**/*.js",
    "src/**/*.d.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}